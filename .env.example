# 复制此文件为 .env，按需填写。也可以不配置这里，直接在网页"设置"中填 key。
# 服务端 .env 中的 key 会作为默认值；网页设置中填写的 key 优先生效。

# Claude (Anthropic)  https://platform.claude.com/
ANTHROPIC_API_KEY=

# OpenAI  https://platform.openai.com/
OPENAI_API_KEY=

# 通义千问（阿里云百炼/DashScope） https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 智谱 GLM  https://open.bigmodel.cn/
ZHIPU_API_KEY=

# DeepSeek  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 自定义 OpenAI 兼容服务的默认 key（接口地址在网页设置中填写）
CUSTOM_API_KEY=

PORT=3000
